---
// A car-dashboard frame wrapping a landscape Android Auto screenshot.
// Home idiom: dark body, subtle brand glow, a wider rounded bottom to read as
// a dashboard. Supports 3D tilt via [data-tilt].
export interface Props {
  src: string;
  alt: string;
}
const { src, alt } = Astro.props;
---

<div class="relative" data-tilt style="transition: transform 0.2s ease-out; transform-style: preserve-3d;">
  <!-- brand glow halo -->
  <div class="absolute -inset-10 bg-brand/20 blur-[70px] rounded-full" aria-hidden="true"></div>

  <div
    class="relative rounded-[1.2rem] rounded-b-[2rem] bg-gradient-to-b from-[#17181a] to-ink-900 border border-white/10 shadow-2xl shadow-black/60 p-3 pb-7 animate-float"
  >
    <div class="absolute inset-0 rounded-[1.2rem] rounded-b-[2rem] ring-1 ring-inset ring-white/5 pointer-events-none"></div>
    <div class="rounded-[0.6rem] overflow-hidden bg-ink-900">
      <img src={src} alt={alt} class="w-full block" loading="lazy" />
    </div>
    <!-- dashboard trim -->
    <div class="absolute bottom-2.5 left-1/2 -translate-x-1/2 w-2/5 h-1.5 rounded-full bg-white/10"></div>
  </div>
</div>
