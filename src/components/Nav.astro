---
const links = [
  { text: 'Features', href: '/features' },
  { text: 'Plugins', href: '/plugins' },
  { text: 'Premium', href: '/premium' },
];
---

<header
  id="nav"
  class="fixed top-0 inset-x-0 z-50 transition-all duration-300 border-b border-transparent"
>
  <nav class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 group">
      <img src="/logo.png" alt="Singlado" class="w-7 h-7 rounded-lg" />
      <span class="font-bold tracking-tight text-white">singlado<span class="text-brand">.</span></span>
    </a>
    <div class="hidden md:flex items-center gap-9 text-[13px] text-neutral-200">
      {links.map((l) => (
        <a href={l.href} class="relative transition-colors hover:text-brand after:absolute after:left-0 after:-bottom-1 after:h-px after:w-0 after:bg-brand after:transition-all hover:after:w-full">{l.text}</a>
      ))}
    </div>
    <a
      href="#get"
      class="rounded-full bg-white/10 hover:bg-white text-white hover:text-ink-900 border border-white/15 font-semibold text-[13px] px-4 py-1.5 transition-all"
      >Get the app</a
    >
  </nav>
</header>

<script is:inline>
  const nav = document.getElementById('nav');
  const onScroll = () => {
    if (window.scrollY > 24) {
      nav.classList.add('bg-ink-900/70', 'backdrop-blur-xl', '!border-white/5');
    } else {
      nav.classList.remove('bg-ink-900/70', 'backdrop-blur-xl', '!border-white/5');
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
