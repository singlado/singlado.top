---
// Stylized phone showing Singlado's player UI, rebuilt in CSS. Supports 3D tilt
// via [data-tilt] (wired in Base.astro). No screenshot needed.
---

<div class="relative" data-tilt style="transition: transform 0.2s ease-out; transform-style: preserve-3d;">
  <!-- layered glows -->
  <div class="absolute -inset-12 bg-brand/30 blur-[90px] rounded-full animate-pulse-slow" aria-hidden="true"></div>
  <div class="absolute -inset-4 bg-emerald-400/10 blur-2xl rounded-[3rem]" aria-hidden="true"></div>

  <div
    class="relative w-[272px] h-[566px] rounded-[2.6rem] bg-gradient-to-b from-ink-700 to-ink-800 border border-white/10 shadow-2xl shadow-brand/20 p-3 animate-float"
  >
    <!-- edge highlight -->
    <div class="absolute inset-0 rounded-[2.6rem] ring-1 ring-inset ring-white/5 pointer-events-none"></div>
    <!-- notch -->
    <div class="absolute top-3 left-1/2 -translate-x-1/2 w-24 h-5 bg-ink-900 rounded-full z-10"></div>

    <div class="w-full h-full rounded-[2.1rem] bg-gradient-to-b from-[#14361f] via-ink-800 to-ink-900 overflow-hidden flex flex-col">
      <div class="flex items-center justify-between px-5 pt-7 pb-2 text-[11px] text-neutral-400">
        <span>Now Playing</span>
        <span class="font-extrabold text-white">singlado<span class="text-brand">.</span></span>
      </div>

      <div class="px-6 mt-4">
        <div class="aspect-square w-full rounded-2xl bg-gradient-to-br from-brand/80 via-emerald-600 to-ink-700 shadow-lg shadow-brand/30 grid place-items-center relative overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/10 to-transparent"></div>
          <svg width="56" height="56" viewBox="0 0 24 24" fill="none" class="opacity-90 relative">
            <path d="M9 18V5l12-2v13" stroke="#06120a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="6" cy="18" r="3" fill="#06120a"/>
            <circle cx="18" cy="16" r="3" fill="#06120a"/>
          </svg>
        </div>
      </div>

      <div class="px-6 mt-5">
        <div class="h-4 w-3/4 rounded bg-white/90"></div>
        <div class="h-3 w-1/2 rounded bg-white/30 mt-2.5"></div>
      </div>

      <div class="px-6 mt-6">
        <div class="h-1.5 w-full rounded-full bg-white/15 overflow-hidden">
          <div class="progress h-full rounded-full bg-gradient-to-r from-brand to-brand-light"></div>
        </div>
        <div class="flex justify-between text-[10px] text-neutral-500 mt-1.5">
          <span>1:54</span><span>4:31</span>
        </div>
      </div>

      <div class="px-6 mt-5 flex items-center justify-between text-white/80">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="opacity-50"><path d="M7 6v12l8.5-6zM17 6h2v12h-2z"/></svg>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17 18V6l-8.5 6zM7 6H5v12h2z"/></svg>
        <div class="w-14 h-14 rounded-full bg-brand grid place-items-center shadow-lg shadow-brand/50">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="#06120a"><path d="M8 5v14l11-7z"/></svg>
        </div>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M7 6v12l8.5-6zM17 6h2v12h-2z"/></svg>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="opacity-50"><path d="M17 18V6l-8.5 6zM7 6H5v12h2z"/></svg>
      </div>

      <div class="mt-auto px-6 pb-8 flex items-end justify-center gap-1.5 h-12">
        <span class="eq-bar" style="animation-delay:0ms"></span>
        <span class="eq-bar" style="animation-delay:120ms"></span>
        <span class="eq-bar" style="animation-delay:240ms"></span>
        <span class="eq-bar" style="animation-delay:80ms"></span>
        <span class="eq-bar" style="animation-delay:300ms"></span>
        <span class="eq-bar" style="animation-delay:180ms"></span>
        <span class="eq-bar" style="animation-delay:60ms"></span>
        <span class="eq-bar" style="animation-delay:220ms"></span>
      </div>
    </div>
  </div>
</div>

<style>
  .eq-bar {
    width: 5px; height: 100%; border-radius: 9999px;
    background: linear-gradient(to top, #1DB954, #7af2a8);
    transform-origin: bottom; animation: eq 1s ease-in-out infinite;
  }
  @keyframes eq { 0%,100% { transform: scaleY(0.25); } 50% { transform: scaleY(1); } }
  .progress { width: 42%; animation: prog 8s ease-in-out infinite alternate; }
  @keyframes prog { from { width: 30%; } to { width: 72%; } }
  @media (prefers-reduced-motion: reduce) {
    .eq-bar { animation: none; transform: scaleY(0.6); }
    .progress { animation: none; }
  }
</style>
