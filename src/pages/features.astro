---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import FeatureRow from '../components/FeatureRow.astro';
import ShotPhone from '../components/ShotPhone.astro';
import CarMock from '../components/CarMock.astro';
---

<Base>
  <Nav />

  <!-- HERO -->
  <section class="relative pt-36 pb-10 px-6 overflow-hidden">
    <div class="aurora" aria-hidden="true"></div>
    <div class="max-w-7xl mx-auto relative">
      <h1 class="text-5xl md:text-7xl font-black tracking-[-0.03em] text-white leading-[0.95]">
        Everything the player<br/>does, <span class="text-gradient">out of the way</span>.
      </h1>
      <p class="mt-6 text-lg text-neutral-400 max-w-xl">One app for the music you bring. Here is what it does, in a clean dark interface.</p>
    </div>
  </section>

  <FeatureRow
    eyebrow="Search"
    title={`Your sources,<br/><span class="text-gradient">one search</span>.`}
    body="Search once and see results from every plugin you added, interleaved as they arrive. Filter down to a single source with a tap."
  >
    <ShotPhone src="/shots/search.png" alt="Singlado multi-source search with provider chips" />
  </FeatureRow>

  <FeatureRow
    eyebrow="Sources"
    title={`Add anything<br/>as a <span class="text-gradient">source</span>.`}
    body="Connect a personal media server like Subsonic, Navidrome or Jellyfin with its address and your login. Or add community plugins: discover them on GitHub, import a file, paste a manifest, or load one from a URL."
    flip={true}
  >
    <ShotPhone src="/shots/add-source.png" alt="Add a source: media server and plugin import" />
  </FeatureRow>

  <FeatureRow
    eyebrow="Playback"
    title={`A player that gets<br/><span class="text-gradient">out of the way</span>.`}
    body="Tap a track and the queue builds itself. Shuffle, repeat, autoplay when it ends. A seek bar that uses the real track length, so dragging lands where you expect. Loudness is leveled across sources automatically."
  >
    <ShotPhone src="/shots/player.png" alt="Singlado full-screen player" />
  </FeatureRow>

  <FeatureRow
    eyebrow="Android Auto"
    title={`In the car,<br/><span class="text-gradient">too</span>.`}
    body="Browse favorites, recent and charts right on the dashboard. Play, skip and shuffle where you drive. Controls also live on the notification, the lock screen, your headphones."
    flip={true}
  >
    <CarMock src="/shots/auto-browse.png" alt="Singlado on Android Auto" />
  </FeatureRow>

  <FeatureRow
    eyebrow="Library"
    title={`Your library,<br/>wherever you <span class="text-gradient">sign in</span>.`}
    body="Favorites, playlists, and a history that picks up where you left off. All tied to your account, so it is there on the next device you sign in on."
  >
    <ShotPhone src="/shots/home.png" alt="Singlado home with charts and recent" />
  </FeatureRow>

  <FeatureRow
    eyebrow="Account"
    title={`Yours to <span class="text-gradient">manage</span>.`}
    body="Pick a profile picture and an accent color. Export a copy of your data whenever you want. Delete your account for good, on your terms. Free listening is always on, with an optional watch-to-unlock when you want an extra play."
    flip={true}
  >
    <ShotPhone src="/shots/settings.png" alt="Singlado settings: avatar, theme, export, delete account" />
  </FeatureRow>

  <!-- footer CTA -->
  <section class="px-6 py-24 text-center">
    <p class="text-2xl md:text-3xl font-bold text-white">Nothing bundled. Just the player.</p>
    <p class="mt-3 text-neutral-400">The sources are <a href="/plugins" class="text-brand hover:text-brand-light underline underline-offset-4">plugins you add</a>. Premium is a <a href="/premium" class="text-brand hover:text-brand-light underline underline-offset-4">one-time purchase</a>.</p>
  </section>
</Base>
