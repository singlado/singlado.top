---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PhoneMock from '../components/PhoneMock.astro';
import FeatureRow from '../components/FeatureRow.astro';
---

<Base>
  <Nav />

  <!-- ================= HERO ================= -->
  <section class="relative min-h-[92vh] flex items-center overflow-hidden">
    <div class="aurora" aria-hidden="true"></div>
    <div class="grid-floor" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-6 w-full grid lg:grid-cols-[1.1fr_0.9fr] gap-16 items-center relative pt-20">
      <div>
        <span class="inline-flex items-center gap-2 text-[13px] font-medium text-neutral-300 bg-white/5 border border-white/10 rounded-full px-3.5 py-1.5 mb-8 backdrop-blur animate-fade-up">
          <span class="w-1.5 h-1.5 rounded-full bg-brand animate-pulse"></span>
          Now on Android · no subscriptions
        </span>

        <h1 class="text-[3.5rem] sm:text-7xl lg:text-[5.5rem] font-black tracking-[-0.03em] text-white leading-[0.95] animate-fade-up">
          The <span class="text-gradient">universal</span>
          <br />music player.
        </h1>

        <p class="mt-7 text-xl text-neutral-400 max-w-lg leading-relaxed animate-fade-up">
          One player for every source — you bring your own, through native
          plugins. <span class="text-white font-medium">Pay once. No subscriptions, ever.</span>
        </p>

        <div class="mt-9 flex flex-wrap gap-4 animate-fade-up">
          <a href="https://play.google.com/store/apps/details?id=com.singlado.singlado"
             class="group rounded-full bg-brand hover:bg-brand-light text-ink-900 font-bold px-8 py-4 transition-all hover:shadow-[0_0_50px_-8px_rgba(29,185,84,0.7)] hover:-translate-y-0.5">
            Get it on Google Play
            <span class="inline-block transition-transform group-hover:translate-x-1">→</span>
          </a>
          <a href="/plugins"
             class="rounded-full text-neutral-300 hover:text-white font-semibold px-6 py-4 transition-colors">
            See how plugins work ↓
          </a>
        </div>
      </div>

      <div class="flex justify-center lg:justify-end [perspective:1200px]">
        <PhoneMock />
      </div>
    </div>

    <!-- scroll cue -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-neutral-600 text-sm animate-pulse-slow hidden md:block">
      scroll ↓
    </div>
  </section>

  <!-- ================= TRUST LINE ================= -->
  <section class="border-y border-white/5">
    <div class="max-w-7xl mx-auto px-6 py-10 flex flex-wrap items-center justify-center gap-x-12 gap-y-4 text-center" data-reveal>
      <p class="text-neutral-500 text-sm">A player that's <span class="text-white font-medium">yours</span> — open to any source, owned not rented.</p>
      <div class="flex items-center gap-10 text-neutral-400 text-sm">
        <span><b class="text-white text-lg">0</b> subscriptions</span>
        <span><b class="text-gradient text-lg">∞</b> sources via plugins</span>
        <span><b class="text-white text-lg">1</b> one-time unlock</span>
      </div>
    </div>
  </section>

  <!-- ================= FEATURE 1: universal / plugins ================= -->
  <FeatureRow
    eyebrow="Open by design"
    title={`A player,<br/><span class="text-gradient">not a walled garden</span>`}
    body="Singlado ships with no catalog. Connect the sources you want — public, private, free or paid — through source plugins. Nothing is bundled; everything is yours to choose."
  >
    <!-- visual: a stack of source plugin chips flowing into the player -->
    <div class="rounded-3xl border border-white/10 bg-ink-800/80 p-6 space-y-3 shadow-2xl shadow-brand/10">
      {['Public API source', 'Private service', 'Free catalog', 'Your paid account'].map((s, i) => (
        <div class={`flex items-center gap-3 rounded-xl border border-white/8 bg-ink-700/60 px-4 py-3 ${i === 3 ? 'ring-1 ring-brand/30' : ''}`}>
          <span class="w-2.5 h-2.5 rounded-full bg-brand"></span>
          <span class="text-sm text-neutral-200">{s}</span>
          <span class="ml-auto text-[11px] text-neutral-500">plugin</span>
        </div>
      ))}
      <div class="flex items-center justify-center pt-1 text-neutral-600">↓</div>
      <div class="rounded-xl bg-gradient-to-r from-brand/20 to-emerald-500/10 border border-brand/30 px-4 py-3 text-center text-sm font-semibold text-brand-light">
        Singlado plays it
      </div>
    </div>
  </FeatureRow>

  <!-- ================= FEATURE 2: playback engine ================= -->
  <FeatureRow
    flip
    eyebrow="Real playback"
    title={`Queue, shuffle,<br/><span class="text-gradient">infinite autoplay</span>`}
    body="A proper engine under the hood: a context queue that builds itself, shuffle and repeat, and autoplay that never lets the silence fall. Control it from the lock screen, your headphones, or the car."
  >
    <div class="rounded-3xl border border-white/10 bg-ink-800/80 p-7 shadow-2xl shadow-brand/10">
      <!-- animated waveform -->
      <div class="flex items-end justify-center gap-1.5 h-28 mb-6">
        {Array.from({ length: 28 }).map((_, i) => (
          <span class="wave-bar" style={`animation-delay:${(i % 7) * 90}ms`}></span>
        ))}
      </div>
      <div class="flex items-center justify-center gap-6 text-neutral-300">
        <span class="text-xs rounded-full border border-white/10 px-3 py-1">shuffle</span>
        <span class="text-xs rounded-full border border-brand/40 text-brand-light px-3 py-1">autoplay ∞</span>
        <span class="text-xs rounded-full border border-white/10 px-3 py-1">repeat</span>
      </div>
    </div>
  </FeatureRow>

  <!-- ================= FEATURE 3: sync ================= -->
  <FeatureRow
    eyebrow="Follows you"
    title={`Favorites & playlists,<br/><span class="text-gradient">synced everywhere</span>`}
    body="Like a track with a tap, build playlists, keep your listening history — all tied to your account and synced across every device you sign in on."
  >
    <div class="relative flex items-center justify-center gap-6 py-6">
      <div class="w-24 h-40 rounded-2xl border border-white/10 bg-ink-700/70 grid place-items-center text-brand">♪</div>
      <div class="flex flex-col items-center gap-1 text-brand-light">
        <span class="text-2xl animate-pulse">⇄</span>
        <span class="text-[11px] text-neutral-500">sync</span>
      </div>
      <div class="w-32 h-52 rounded-2xl border border-brand/30 bg-ink-700/70 grid place-items-center text-brand shadow-lg shadow-brand/20">♥</div>
    </div>
  </FeatureRow>

  <!-- ================= FEATURE 4: no subscriptions (the pitch) ================= -->
  <section class="relative overflow-hidden py-28">
    <div class="aurora" aria-hidden="true"></div>
    <div class="max-w-4xl mx-auto px-6 text-center relative" data-reveal>
      <span class="text-brand-light font-semibold text-[13px] tracking-[0.2em] uppercase">The pledge</span>
      <h2 class="mt-5 text-4xl md:text-6xl font-black text-white tracking-tight leading-[1.05]">
        No subscriptions.<br /><span class="text-gradient">Ever.</span>
      </h2>
      <p class="mt-6 text-neutral-400 text-lg max-w-2xl mx-auto leading-relaxed">
        Most apps rent you your own music, month after month. We don't. The free
        version is fully functional; Premium is a <span class="text-white font-medium">single one-time
        purchase</span> that removes ads. Pay once, keep it — no "per month", no auto-renew.
      </p>
      <a href="/premium" class="inline-block mt-8 text-brand-light hover:text-white font-semibold transition-colors">Why one-time, not a subscription →</a>
    </div>
  </section>

  <!-- ================= PLUGIN CODE SPOTLIGHT ================= -->
  <section class="relative max-w-7xl mx-auto px-6 py-24">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div data-reveal>
        <span class="text-brand-light font-semibold text-[13px] tracking-[0.2em] uppercase">For builders</span>
        <h2 class="mt-4 text-3xl md:text-5xl font-black text-white tracking-tight leading-tight">
          A plugin is<br /><span class="text-gradient">just a spec</span>
        </h2>
        <p class="mt-5 text-neutral-400 text-lg leading-relaxed max-w-md">
          No arbitrary code — a small, data-driven JSON spec tells Singlado how
          to search a service and resolve a playable stream. Anyone can write one.
        </p>
        <a href="/plugins" class="group inline-flex items-center gap-2 mt-7 rounded-full border border-brand/40 hover:bg-brand/10 text-brand-light font-semibold px-6 py-3 transition-colors">
          Read the plugin guide
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </a>
      </div>
      <div data-reveal data-tilt style="transition: transform 0.2s ease-out;">
        <div class="rounded-2xl border border-white/10 bg-ink-800 overflow-hidden shadow-2xl shadow-brand/10">
          <div class="flex items-center gap-1.5 px-4 py-3 border-b border-white/5">
            <span class="w-3 h-3 rounded-full bg-red-500/70"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500/70"></span>
            <span class="w-3 h-3 rounded-full bg-green-500/70"></span>
            <span class="ml-3 text-xs text-neutral-500">source-plugin.json</span>
          </div>
          <pre class="p-5 text-[12.5px] leading-relaxed overflow-x-auto"><code class="text-neutral-300">{`{
  `}<span class="text-brand-light">"resolvesBy"</span>{`: "RESOLVES_BY_NAME",
  `}<span class="text-brand-light">"searchTemplate"</span>{`: "scsearch:{query}",
  `}<span class="text-brand-light">"itemUrlTemplate"</span>{`:
    "https://soundcloud.com/{handle}",
  `}<span class="text-brand-light">"formatSelector"</span>{`:
    "bestaudio[ext=m4a]/bestaudio",
  `}<span class="text-brand-light">"tiers"</span>{`: [
    { "label": "fast" },
    { "label": "robust", "jsRuntimes": ["deno"] }
  ]
}`}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= FINAL CTA ================= -->
  <section class="relative overflow-hidden py-36">
    <div class="aurora" aria-hidden="true"></div>
    <div class="max-w-3xl mx-auto px-6 text-center relative" data-reveal>
      <img src="/logo.png" alt="" class="w-20 h-20 rounded-2xl mx-auto mb-8 shadow-xl shadow-brand/30" />
      <h2 class="text-4xl md:text-7xl font-black text-white tracking-tight leading-[1.02]">
        Your music.<br />Your sources.<br /><span class="text-gradient">One player.</span>
      </h2>
      <a href="https://play.google.com/store/apps/details?id=com.singlado.singlado"
         class="group inline-flex items-center gap-2 mt-10 rounded-full bg-brand hover:bg-brand-light text-ink-900 font-bold px-10 py-4 text-lg transition-all hover:shadow-[0_0_60px_-8px_rgba(29,185,84,0.8)] hover:-translate-y-0.5">
        Get it on Google Play
        <span class="transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>
  </section>

  <footer class="border-t border-white/5">
    <div class="max-w-7xl mx-auto px-6 py-10 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-neutral-500">
      <div class="flex items-center gap-2">
        <img src="/logo.png" alt="" class="w-6 h-6 rounded" />
        <span>© 2026 Singlado</span>
      </div>
      <div class="flex gap-6">
        <a href="/features" class="hover:text-neutral-300">Features</a>
        <a href="/plugins" class="hover:text-neutral-300">Plugins</a>
        <a href="/premium" class="hover:text-neutral-300">Premium</a>
        <a href="/privacy" class="hover:text-neutral-300">Privacy</a>
      </div>
    </div>
  </footer>

  <style>
    .wave-bar {
      width: 4px; border-radius: 9999px;
      background: linear-gradient(to top, #1DB954, #7af2a8);
      height: 100%; transform-origin: bottom;
      animation: wv 1.1s ease-in-out infinite;
    }
    @keyframes wv { 0%,100% { transform: scaleY(0.2); } 50% { transform: scaleY(1); } }
    @media (prefers-reduced-motion: reduce) { .wave-bar { animation: none; transform: scaleY(0.5); } }
  </style>
</Base>
