---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
---

<Base title="Payment cancelled | Singlado" description="Your Premium purchase was cancelled.">
  <div class="relative min-h-screen">
    <div class="aurora" aria-hidden="true"></div>
    <Nav />
    <main class="relative z-10 mx-auto max-w-xl px-6 pb-24 pt-24 text-center">
      <h1 class="mt-4 text-3xl font-extrabold tracking-tight">Payment cancelled</h1>
      <p class="mt-4 text-lg text-neutral-300">
        No charge was made. You can try again whenever you like.
      </p>
      <a href="/premium" class="mt-8 inline-block rounded-lg bg-brand px-5 py-2.5 font-semibold text-ink-900 transition hover:brightness-110">
        Back to Premium
      </a>
    </main>
  </div>
</Base>
