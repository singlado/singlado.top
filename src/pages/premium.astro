---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';

// Public config (not secrets). The Google web client id is added once it exists
// in Google Cloud (OAuth "Web application", authorized origin https://singlado.top).
const API_BASE = 'https://api.singlado.top';
const GOOGLE_WEB_CLIENT_ID = '249125668898-smfe3o1hht5glrguuh6a74d1kicpcqnl.apps.googleusercontent.com';
---

<Base title="Premium · Singlado" description="Buy Singlado once for your account. No subscription, no expiry.">
  <div class="relative min-h-screen">
    <div class="aurora" aria-hidden="true"></div>
    <Nav />

    <main class="relative z-10 mx-auto max-w-2xl px-6 pb-28 pt-28">

      <!-- HERO -->
      <h1 class="text-[2.8rem] sm:text-6xl font-black tracking-[-0.03em] text-white leading-[1.05]">
        Subscriptions are <span class="italic text-brand">démodé</span>.
      </h1>
      <h1 class="text-[2.8rem] sm:text-6xl font-black tracking-[-0.03em] text-white leading-[1.05] whitespace-nowrap">
        Buy the app, like in the <span class="text-brand">1990s</span>.
      </h1>

      <div class="my-8 h-[3px] w-28" style="background: repeating-linear-gradient(90deg, #1DB954 0 10px, transparent 10px 18px);"></div>

      <p class="text-2xl sm:text-3xl font-extrabold tracking-[-0.01em] text-white">Pay once. It's yours.</p>
      <p class="text-2xl sm:text-3xl font-extrabold tracking-[-0.01em] text-neutral-500">No subscription. No expiry. No price creep.</p>

      <!-- PRICE (filled live from the backend; the number is never hardcoded) -->
      <div class="mt-12">
        <div id="product-line" class="text-6xl font-black tracking-[-0.03em] text-white leading-none">
          <span class="text-neutral-600 text-2xl font-bold">Loading price…</span>
        </div>
        <p class="mt-3 text-lg text-neutral-400">One time. Not every month.</p>
      </div>

      <!-- THREE CHECKS -->
      <div class="mt-10 flex flex-col gap-5 max-w-lg">
        <div class="flex items-center gap-3.5"><span class="text-brand text-lg">✓</span><span class="text-[17px] text-neutral-200">No ads. Just music.</span></div>
        <div class="flex items-center gap-3.5"><span class="text-brand text-lg">✓</span><span class="text-[17px] text-neutral-200">Every track plays instantly.</span></div>
        <div class="flex items-center gap-3.5"><span class="text-brand text-lg">✓</span><span class="text-[17px] text-neutral-200">Works on every device you sign in on.</span></div>
      </div>

      <!-- HONEST SMALL PRINT -->
      <div class="mt-8 text-sm leading-7 text-neutral-500 max-w-xl">
        You buy the <strong class="text-neutral-300">v1 license</strong>.<br/>
        A future v2 would be a separate buy. Your v1 stays unlocked.<br/>
        We keep all the older versions running as long as we can.
      </div>

      <!-- PURCHASE FORM (the one real box) -->
      <div class="mt-12 rounded-2xl border border-white/10 bg-ink-800/80 p-7">
        <div class="flex items-baseline justify-between">
          <div class="font-bold text-white">Unlock Singlado license v1</div>
          <div id="form-price" class="font-bold text-brand"></div>
        </div>
        <p class="mt-1 text-sm text-neutral-400">Sign in to the account you want to unlock.</p>

        <div id="auth-box" class="mt-5">
          <form id="login-form" class="space-y-3">
            <input id="email" type="email" autocomplete="email" required placeholder="Email"
              class="w-full rounded-lg border border-white/10 bg-ink-900/60 px-4 py-2.5 text-neutral-100 outline-none focus:border-brand/60" />
            <input id="password" type="password" autocomplete="current-password" placeholder="Password"
              class="w-full rounded-lg border border-white/10 bg-ink-900/60 px-4 py-2.5 text-neutral-100 outline-none focus:border-brand/60" />
            <button id="login-btn" type="submit"
              class="w-full rounded-lg bg-brand px-4 py-2.5 font-semibold text-ink-900 transition hover:brightness-110 disabled:opacity-50">
              Sign in and continue
            </button>
          </form>

          <div id="google-wrap" class="mt-3 hidden">
            <div class="my-3 flex items-center gap-3 text-xs text-neutral-500">
              <span class="h-px flex-1 bg-white/10"></span>or<span class="h-px flex-1 bg-white/10"></span>
            </div>
            <!-- custom full-width button with the app's gradient G -->
            <button id="google-btn" type="button"
              class="flex w-full items-center justify-center gap-2.5 rounded-lg bg-white px-4 py-2.5 font-semibold text-[#1f1f1f] transition hover:brightness-95">
              <img src="/google_g.svg" width="18" height="18" alt="" /> Continue with Google
            </button>
          </div>

          <p id="auth-msg" class="mt-3 text-sm" role="status" aria-live="polite"></p>
        </div>

        <div id="owned-box" class="mt-5 hidden">
          <p class="text-lg font-semibold text-brand">You already have Premium 🎉</p>
          <p class="mt-1 text-sm text-neutral-400">This account is already unlocked. Open Singlado and enjoy, no second purchase needed.</p>
        </div>
      </div>
    </main>
  </div>

  {GOOGLE_WEB_CLIENT_ID && (
    <script is:inline src="https://accounts.google.com/gsi/client" async></script>
  )}

  <script is:inline define:vars={{ API_BASE, GOOGLE_WEB_CLIENT_ID }}>
    const msg = document.getElementById('auth-msg');
    const productLine = document.getElementById('product-line');
    const formPrice = document.getElementById('form-price');
    const authBox = document.getElementById('auth-box');
    const ownedBox = document.getElementById('owned-box');
    const loginForm = document.getElementById('login-form');
    const loginBtn = document.getElementById('login-btn');

    let sellingMajor = null;

    const setMsg = (text, ok) => {
      msg.textContent = text || '';
      msg.className = 'mt-3 text-sm ' + (ok ? 'text-brand' : 'text-red-400');
    };
    const money = (minor, currency) => {
      try {
        return new Intl.NumberFormat(undefined, { style: 'currency', currency: (currency || 'EUR').toUpperCase() })
          .format((minor || 0) / 100);
      } catch { return ((minor || 0) / 100).toFixed(2) + ' ' + (currency || '').toUpperCase(); }
    };

    // Load price + version from the backend (never hardcoded).
    (async () => {
      try {
        const r = await fetch(`${API_BASE}/billing/price`);
        const d = await r.json();
        if (d && d.price != null) {
          sellingMajor = d.version;
          productLine.innerHTML = `${money(d.price, d.currency)}<span class="text-2xl text-neutral-500 font-bold"> once</span>`;
          formPrice.textContent = money(d.price, d.currency);
        } else {
          productLine.innerHTML = '<span class="text-neutral-400 text-2xl font-bold">Price temporarily unavailable</span>';
          loginBtn.disabled = true;
        }
      } catch {
        productLine.innerHTML = '<span class="text-neutral-400 text-2xl font-bold">Price temporarily unavailable</span>';
        loginBtn.disabled = true;
      }
    })();

    async function afterLogin(token) {
      try {
        const r = await fetch(`${API_BASE}/me/entitlements`, {
          headers: { Authorization: `Bearer ${token}`, 'X-App-Major': String(sellingMajor ?? '') },
        });
        if (r.ok) {
          const ent = await r.json();
          if (ent && ent.flags && ent.flags.licensed === true) {
            authBox.classList.add('hidden');
            ownedBox.classList.remove('hidden');
            return;
          }
        }
      } catch { /* non-fatal */ }

      try {
        setMsg('Opening checkout…', true);
        const r = await fetch(`${API_BASE}/billing/stripe/checkout`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}`, 'X-App-Major': String(sellingMajor ?? '') },
          body: JSON.stringify({ major: sellingMajor }),
        });
        if (r.status === 409) { authBox.classList.add('hidden'); ownedBox.classList.remove('hidden'); return; }
        if (!r.ok) throw new Error('checkout');
        const d = await r.json();
        if (!d || !d.url) throw new Error('nourl');
        window.location = d.url;
      } catch {
        setMsg("Couldn't start the payment, please try again.", false);
      }
    }

    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      setMsg('', true);
      loginBtn.disabled = true;
      const email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;
      try {
        const r = await fetch(`${API_BASE}/auth/login`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password }),
        });
        if (r.status === 401) { setMsg('Email or password not correct. If you signed up with Google, use Continue with Google.', false); loginBtn.disabled = false; return; }
        if (r.status === 403) { setMsg('Please verify your email in the Singlado app first, then come back.', false); loginBtn.disabled = false; return; }
        if (!r.ok) throw new Error('login');
        const d = await r.json();
        const token = d.access_token || d.accessToken || (d.session && d.session.access_token);
        if (!token) throw new Error('notoken');
        await afterLogin(token);
      } catch {
        setMsg('Something went wrong. Please try again.', false);
      } finally {
        if (!ownedBox || ownedBox.classList.contains('hidden')) loginBtn.disabled = false;
      }
    });

    // Google login via a custom full-width button (the app's gradient G).
    if (GOOGLE_WEB_CLIENT_ID) {
      document.getElementById('google-wrap').classList.remove('hidden');
      const init = () => {
        if (!window.google || !google.accounts || !google.accounts.id) { setTimeout(init, 300); return; }
        google.accounts.id.initialize({
          client_id: GOOGLE_WEB_CLIENT_ID,
          callback: async (resp) => {
            try {
              const r = await fetch(`${API_BASE}/auth/social/google`, {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id_token: resp.credential }),
              });
              if (!r.ok) throw new Error('google');
              const d = await r.json();
              const token = d.access_token || d.accessToken || (d.session && d.session.access_token);
              if (!token) throw new Error('notoken');
              await afterLogin(token);
            } catch {
              setMsg('Google sign-in failed. Please try again.', false);
            }
          },
        });
        document.getElementById('google-btn').addEventListener('click', () => {
          google.accounts.id.prompt();
        });
      };
      init();
    }
  </script>
</Base>
