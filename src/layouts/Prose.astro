---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
export interface Props { title: string; subtitle?: string; }
const { title, subtitle } = Astro.props;
---

<Base title={`${title} | Singlado`}>
  <Nav />
  <section class="relative overflow-hidden pt-28 pb-10">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute top-0 left-1/4 w-[30rem] h-[20rem] bg-brand/15 blur-[110px] rounded-full"></div>
    </div>
    <div class="max-w-3xl mx-auto px-5">
      <h1 class="text-4xl md:text-5xl font-black text-white tracking-tight">{title}</h1>
      {subtitle && <p class="mt-4 text-lg text-neutral-400">{subtitle}</p>}
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-5 pb-28">
    <div class="prose-singlado">
      <slot />
    </div>
  </section>

  <footer class="border-t border-white/5">
    <div class="max-w-6xl mx-auto px-5 py-8 flex items-center justify-between text-sm text-neutral-500">
      <span>© 2026 Singlado</span>
      <a href="/" class="hover:text-neutral-300">← Home</a>
    </div>
  </footer>

  <style is:global>
    .prose-singlado { color: #c9c9c9; line-height: 1.75; }
    .prose-singlado h2 { color: #fff; font-weight: 800; font-size: 1.6rem; margin: 2.5rem 0 1rem; }
    .prose-singlado h3 { color: #1ed760; font-weight: 700; font-size: 1.15rem; margin: 2rem 0 0.75rem; }
    .prose-singlado p { margin: 1rem 0; }
    .prose-singlado a { color: #1ed760; text-decoration: underline; text-underline-offset: 3px; }
    .prose-singlado ul { margin: 1rem 0; padding-left: 1.25rem; list-style: disc; }
    .prose-singlado li { margin: 0.4rem 0; }
    .prose-singlado strong { color: #fff; }
    .prose-singlado table { width: 100%; margin: 1.5rem 0; border-collapse: collapse; font-size: 0.9rem; }
    .prose-singlado th, .prose-singlado td { border: 1px solid #262626; padding: 0.6rem 0.8rem; text-align: left; }
    .prose-singlado th { background: #141414; color: #fff; }
    .prose-singlado code { background: #161616; color: #7af2a8; padding: 0.15rem 0.4rem; border-radius: 6px; font-size: 0.85em; }
    .prose-singlado pre { background: #0d0d0d; border: 1px solid #1f1f1f; border-radius: 12px; padding: 1.1rem; overflow-x: auto; margin: 1.5rem 0; }
    .prose-singlado pre code { background: none; color: #c9c9c9; padding: 0; }
    .prose-singlado hr { border-color: #222; margin: 2rem 0; }
    .prose-singlado .pledge { border: 1px solid #1DB954; background: rgba(29,185,84,0.1); border-radius: 14px; padding: 1.25rem 1.5rem; margin: 2rem 0; }
  </style>
</Base>
